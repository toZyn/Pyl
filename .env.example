# Telegram API credentials: https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash

# Choose exactly one connection mode: token OR phone.
BOT_TOKEN=
PHONE_NUMBER=+51999999999

# Optional: where GramJS stores the session. Keep this file private.
SESSION_FILE=.data/pyl.session

# Optional: customize the bot display name
PYL_NAME=Pyl
